{
  "name": "snoop",
  "displayName": "Snoop — AI Function Explainer",
  "description": "Hover over unfamiliar code and understand it instantly. AI-powered explanations of what a function actually does — great for legacy code and undocumented libraries.",
  "version": "0.2.5",
  "publisher": "wintershin",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/juyeong-s/snoop.git"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Education",
    "Machine Learning",
    "Debuggers"
  ],
  "keywords": [
    "ai",
    "explain",
    "hover",
    "documentation",
    "legacy code",
    "onboarding",
    "codebase"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "snoop.explain",
        "title": "Snoop: Explain This Function"
      },
      {
        "command": "snoop.setApiKey",
        "title": "Snoop: Set API Key"
      },
      {
        "command": "snoop.selectLanguage",
        "title": "Snoop: Select Language"
      },
      {
        "command": "snoop.clearCache",
        "title": "Snoop: Clear Cache"
      },
      {
        "command": "snoop.clearComments",
        "title": "Snoop: Clear Inline Results"
      },
      {
        "command": "snoop.askFollowUp",
        "title": "질문하기",
        "enablement": "!commentIsEmpty"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "snoop.askFollowUp",
          "group": "inline",
          "when": "commentController == snoop"
        }
      ],
      "commandPalette": [
        {
          "command": "snoop.askFollowUp",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Snoop",
      "properties": {
        "snoop.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover explanations."
        },
        "snoop.provider": {
          "type": "string",
          "enum": [
            "gemini",
            "openai",
            "anthropic",
            "groq",
            "ollama"
          ],
          "default": "gemini",
          "description": "AI provider. Ollama runs locally and needs no API key."
        },
        "snoop.model": {
          "type": "string",
          "default": "",
          "description": "Model name. Leave empty to use the provider's default."
        },
        "snoop.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Override the API base URL. Leave empty for the default."
        },
        "snoop.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "ko",
            "ja",
            "zh-CN",
            "zh-TW",
            "es",
            "fr",
            "de",
            "pt-BR",
            "ru",
            "it",
            "vi",
            "id",
            "hi",
            "th",
            "tr",
            "pl"
          ],
          "enumDescriptions": [
            "Follow the editor's display language",
            "English",
            "한국어 (Korean)",
            "日本語 (Japanese)",
            "简体中文 (Simplified Chinese)",
            "繁體中文 (Traditional Chinese)",
            "Español (Spanish)",
            "Français (French)",
            "Deutsch (German)",
            "Português do Brasil (Portuguese)",
            "Русский (Russian)",
            "Italiano (Italian)",
            "Tiếng Việt (Vietnamese)",
            "Bahasa Indonesia",
            "हिन्दी (Hindi)",
            "ไทย (Thai)",
            "Türkçe (Turkish)",
            "Polski (Polish)"
          ],
          "default": "auto",
          "description": "Language for explanations."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "vsce package --no-yarn",
    "check": "yarn compile && vsce package --no-yarn --out /tmp/snoop-check.vsix && unzip -l /tmp/snoop-check.vsix",
    "publish:ovsx": "ovsx publish -p $OVSX_TOKEN",
    "publish:vsce": "vsce publish",
    "release:patch": "npm version patch && yarn vsix && yarn publish:ovsx",
    "release:minor": "npm version minor && yarn vsix && yarn publish:ovsx"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
