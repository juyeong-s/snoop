{
  "name": "snoop",
  "displayName": "Snoop — AI Function Explainer",
  "description": "Hover over unfamiliar code and understand it instantly. AI-powered explanations of what a function actually does — great for legacy code and undocumented libraries.",
  "version": "0.2.0",
  "publisher": "wintershin",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/juyeong-s/snoop.git"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "snoop.explain",
        "title": "Snoop: Explain This Function"
      },
      {
        "command": "snoop.setApiKey",
        "title": "Snoop: Set API Key"
      },
      { "command": "snoop.selectLanguage",
        "title": "Snoop: Select Language"
      },
      {
        "command": "snoop.clearCache",
        "title": "Snoop: Clear Cache"
      }
    ],
    "configuration": {
      "title": "Snoop",
      "properties": {
        "snoop.enabled": {
          "type": "boolean",
          "default": true
        },
        "snoop.provider": {
          "type": "string",
          "enum": [
            "gemini",
            "openai",
            "anthropic",
            "groq",
            "ollama"
          ],
          "default": "gemini"
        },
        "snoop.model": {
          "type": "string",
          "default": ""
        },
        "snoop.baseUrl": {
          "type": "string",
          "default": ""
        },
        "snoop.language": {
          "type": "string",
          "enum": [
            "auto", "en", "ko", "ja", "zh-CN", "zh-TW", "es", "fr",
            "de", "pt-BR", "ru", "it", "vi", "id", "hi", "th", "tr", "pl"
          ],
          "enumDescriptions": [
            "Follow the editor's display language",
            "English",
            "한국어 (Korean)",
            "日本語 (Japanese)",
            "简体中文 (Simplified Chinese)",
            "繁體中文 (Traditional Chinese)",
            "Español (Spanish)",
            "Français (French)",
            "Deutsch (German)",
            "Português do Brasil (Portuguese)",
            "Русский (Russian)",
            "Italiano (Italian)",
            "Tiếng Việt (Vietnamese)",
            "Bahasa Indonesia",
            "हिन्दी (Hindi)",
            "ไทย (Thai)",
            "Türkçe (Turkish)",
            "Polski (Polish)"
          ],
          "default": "auto",
          "description": "Language for explanations."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
